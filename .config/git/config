# see http://durdn.com/blog/2012/11/22/must-have-git-aliases-advanced-examples/
[alias]
	au = add --update
	bi = bisect
	br = branch
	re = rebase
	ci = commit
	co = checkout
	ss = status --short
	st = status
	cp = cherry-pick
	wt = worktree

	# Safer everyday helpers
	amend = commit --amend --reuse-message=HEAD
	amend-edit = commit --amend
	unstage = restore --staged --
	discard = restore --worktree --

	# Show diffs of the last commit
	# last = -c core.pager= log --patch --max-count=1
	# last = -c core.pager=delta log --patch --max-count=1
	last = -c diff.external=difft log --patch --max-count=1 --ext-diff
	#
	# dl = -c core.pager= log --patch --max-count=1
	# dl = -c core.pager=delta log --patch --max-count=1
	dl = -c diff.external=difft log --patch --max-count=1 --ext-diff

	root = rev-parse --show-toplevel

	# -s, --no-messages    suppress error messages
	who = shortlog --no-messages --

	# Dangerous by design. Kept for muscle memory; prefer `git discard <path>`
	# when possible.
	undo = reset --hard

	lg       = log                                    --color               --pretty=format:'%Cred%h%Creset%C(white) %ad%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset' --date=short
	lg-all   = log --graph --full-history             --color         --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset'
	# Pass an optional count to lg-n/lg-all-n, e.g.: `git lg-n 50`
	lg-n     = "!f() { n=${1:-20}; shift || true; git log --max-count=\"$n\" --color --date=short --pretty=format:'%Cred%h%Creset%C(white) %ad%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset' \"$@\"; }; f"
	lg-all-n = "!f() { n=${1:-20}; shift || true; git log --graph --max-count=\"$n\" --color --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset' \"$@\"; }; f"
	alg      = log --graph --abbrev-commit            --color               --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset' --
	lg1      = log --graph --abbrev-commit --decorate --date=relative --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
	lg2      = log --graph --abbrev-commit --decorate                 --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'

	cb = branch --show-current
	# Read, modify and delete symbolic refs
	# cb = symbolic-ref HEAD --short

	# show branches
	sb = !ls .git/refs/remotes/*/$(git cb) | cut -d/ -f4,5 | xargs git show-branch $(git cb)
	# sb = "!f() { branch=$(git branch --show-current) || exit; git for-each-ref --format='%(refname:short)' refs/remotes | grep --extended-regexp --invert-match '/HEAD$' | grep --fixed-strings -- \"/$branch\" | xargs --no-run-if-empty git show-branch \"$branch\"; }; f"

	# Text-mode interface for Git
	tig = !tig

	# Show the most recent commit with difftastic
	# ds = -c core.pager= show
	# ds = -c core.pager=delta show
	ds = -c diff.external=difft show --ext-diff

	# df = -c core.pager= diff
	# df = -c core.pager=delta diff
	# df = -c core.pager=delta -c delta.side-by-side=true -c delta.line-numbers=false diff
	df = -c diff.external=difft diff

	# dfw = -c core.pager= diff --word-diff=color
	# dfw = -c core.pager=delta diff --word-diff=color
	dfw = -c diff.external=difft diff --word-diff=color

	# dis = -c core.pager= diff --cached HEAD^
	# dis = -c core.pager='less --tabs=4 --RAW-CONTROL-CHARS --quit-if-one-screen' diff --cached HEAD^
	# dis = -c core.pager=delta diff --cached HEAD^
	dis = -c diff.external=difft diff --cached HEAD^

	# Find a tracked file, case-insensitively.
	ff = "!git ls-files | grep --ignore-case"

	sl = stash list
	sp = stash pop
	sw = stash show --patch
	sa = stash push --include-untracked

	# Search in commit contents and commit messages
	# ! is needed to pass argument correctly to -S
	fsc = "!git log --color --patch -S "
	fsm = "!git log --grep "

	# All commits which touched this path (one-line output)
	touched = "!f() { git log --oneline -- \"$1\"; }; f"
	# Full log of commits which touched this path
	touched-full = "!f() { git log -- \"$1\"; }; f"
	# Just commit hashes which touched this path
	touched-hashes = "!f() { git log --format=\"%H\" -- \"$1\"; }; f"


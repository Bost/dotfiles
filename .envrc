#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash -*-

## bash -n .envrc
## shellcheck .envrc

# export gpgPubKey="5D027CEF97C8FE6DE39370BD9403F3A0D4BAFE08" # no expiration, no password ugh
export gpgPubKey="A2FED89D9A10000E5BF63B37612D36368877DC81"   # no expiration

# See https://www.postgresql.org/docs/current/libpq-connect.html#LIBPQ-CONNSTRING
# Using no password:
#     export DATABASE_URL=postgres://postgres@localhost:5432/postgres
# doesn't work.

# gpg --decrypt .env-secrets.gpg > .env-secrets
# <edit .env-secrets>
# gpg --encrypt --output .env-secrets.gpg --recipient $gpgPubKey .env-secrets
# shred --verbose --remove .env-secrets

# fish runs the direnv hook with the terminal still in its own line-editor
# mode (-icrnl -icanon), so Enter sends "\r" and the loopback passphrase prompt
# never sees the end of the line. Temporarily switch the line discipline back,
# and restore fish's state afterwards. No-op without a controlling terminal.
tty_state=$(stty -g </dev/tty 2>/dev/null)
[ -n "$tty_state" ] && stty icrnl icanon </dev/tty

# shellcheck disable=SC1090
source <(gpg --pinentry-mode=loopback --quiet --for-your-eyes-only --decrypt .env-secrets.gpg)

[ -n "$tty_state" ] && stty "$tty_state" </dev/tty
unset tty_state
